<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Permite hablar con la API por HTTP (no HTTPS) en desarrollo local.
	     NSAllowsLocalNetworking cubre localhost/.local (simulador).
	     NSAllowsArbitraryLoads cubre un iPad físico apuntando a la IP de la Mac.
	     Esto es SOLO para desarrollo; en producción se usaría HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
