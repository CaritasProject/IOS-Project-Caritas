# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube al repositorio.

ENTORNO=desarrollo

# Flask
FLASK_APP=main.py
FLASK_DEBUG=1
API_PUERTO=5000

# Conexión a SQL Server (coincide con api/docker-compose.yml)
SQLSERVER_HOST=localhost
SQLSERVER_PUERTO=1433
SQLSERVER_BASE=SistemaIngresos
SQLSERVER_USUARIO=sa
SQLSERVER_PASSWORD=Caritas!2026
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# En local usamos HTTP sin cifrado; por eso Encrypt=no y confiamos en el cert.
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_CERT=yes

# Autenticación
JWT_SECRETO=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=43200
