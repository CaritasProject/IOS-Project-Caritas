# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube al repositorio.

ENTORNO=desarrollo

# Flask
FLASK_APP=main.py
FLASK_DEBUG=0

# Conexión a SQL Server
SQLSERVER_HOST=
SQLSERVER_PUERTO=1433
SQLSERVER_BASE=
SQLSERVER_USUARIO=api_caritas
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERT=yes

# Autenticación
JWT_SECRETO=
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=480

# Secreto que se mezcla con la contraseña antes del hash. Si cambia, nadie puede iniciar sesión.
PEPPER=
